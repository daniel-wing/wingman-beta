<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Used only when signing with an Apple Developer ID (DEVELOPER_ID=1 ./install.sh),
  which turns on the hardened runtime. The hardened runtime blocks these resources
  unless the app declares them; macOS still asks the person the first time.
  System audio capture (Core Audio taps) and speech recognition need only their
  Info.plist usage texts.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
